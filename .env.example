# ─────────────────────────────────────────────────────────────
# پرو مجازی (Virtual Try-On) — سه حالت. این فایل را به .env.local کپی کنید.
# ─────────────────────────────────────────────────────────────

# ▸ پیش‌فرض: رایگان و بدون ثبت‌نام (Hugging Face — Kolors)
#   هیچ کاری لازم نیست.
#   ⚠️ یک دموی عمومیِ مشترک است: اغلب شلوغ یا موقتاً down می‌شود و برای
#      فروشگاهِ واقعی مناسب نیست (خودِ سازنده هم می‌گوید production نیست).
#   (اختیاری) توکنِ رایگانِ HF برای محدودیت کمتر: https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxx

# ▸ حالتِ قابل‌اعتماد (پیشنهادی) — fal.ai (همان مدلِ Kolors، سریع و پایدار، ~$۰٫۰۷ هر تصویر)
#   کلید: https://fal.ai/dashboard/keys
# TRYON_PROVIDER=fal
# FAL_KEY=xxxxxxxxxxxxxxxx

# ▸ حالتِ حرفه‌ایِ خصوصی — FASHN (~$۰٫۰۷۵ هر تصویر)
#   کلید: https://fashn.ai  (بخش Developer/API)
# TRYON_PROVIDER=fashn
# FASHN_API_KEY=xxxxxxxxxxxxxxxx

# نکته امنیتی: هیچ‌کدام را با NEXT_PUBLIC_ شروع نکنید — همه فقط سمت سرور می‌مانند.

# ─────────────────────────────────────────────────────────────
# احراز هویت (Better Auth) + دیتابیس (MongoDB)
# ─────────────────────────────────────────────────────────────

# ▸ آدرس MongoDB — همان چیزی که mongoose و آداپتور Better Auth به آن وصل می‌شوند.
MONGODB_URI=mongodb://localhost:27017/malli-kids

# ▸ کلید امضای سشن/توکن‌ها — اجباری. با یکی از این دو بسازید:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# ▸ آدرس پایهٔ سایت (برای ساختن لینکِ بازنشانیِ رمز). در dev همین مقدار کافی است.
BETTER_AUTH_URL=http://localhost:3000

# ▸ (اختیاری) بوت‌استرپِ اولین ادمین — ایمیلِ حساب‌های عادی (ثبت‌نامی از همان
#   فرمِ فروشگاه) که باید به «/admin» دسترسی داشته باشند، جدا با کاما. راهِ
#   پایدارتر برای ادمین‌های بعدی: فیلدِ role در دیتابیس (نگاه کنید به
#   src/lib/auth/admin.ts).
# ADMIN_EMAILS=you@mallikids.ir

# ▸ (اختیاری) ارسالِ واقعیِ ایمیل («فراموشیِ رمز عبور» و ...) با SMTP —
#   هر سرویسی: Gmail (با App Password، نه رمزِ خودِ اکانت)، سرورِ خودتان، و غیره.
#   بدون SMTP_HOST، ایمیل فقط در کنسولِ سرور لاگ می‌شود (کافی برای dev).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM="ملی‌کیدز <you@gmail.com>"

# ─────────────────────────────────────────────────────────────
# نقشه‌ی پروفایل (انتخاب آدرس روی نقشه‌ی Leaflet/نشان)
# ─────────────────────────────────────────────────────────────
# هر دو کلید را از platform.neshan.org بسازید (رایگان، ثبت‌نام لازم است).
# بدون این دو، دکمه‌ی «انتخاب روی نقشه» در پروفایل غیرفعال می‌ماند.

# ▸ کلید سروری — فقط برای reverse geocoding (تبدیل نقطه به متن آدرس)،
#   هرگز به کلاینت نمی‌رود (فقط `reverseGeocodeAction` می‌خواندش).
# NESHAN_API_KEY=xxxxxxxxxxxxxxxx

# ▸ کلید نقشه — برای بارگذاریِ تایل‌های نقشه در مرورگر. این یکی طبیعتاً در
#   درخواست‌های تصویر نقشه دیده می‌شود (مثل کلید نقشه‌ی گوگل/مپ‌باکس)؛
#   حتماً در پنل نشان روی دامنه‌ی سایتتان محدودش کنید (Domain Restriction).
# NEXT_PUBLIC_NESHAN_MAP_KEY=xxxxxxxxxxxxxxxx
