# ── ملی‌کیدز · نمونه پیکربندی محیط ─────────────────────────────
# این فایل را با نام `.env` کپی کنید و مقادیر واقعی را بگذارید.
# `.env` در گیت کامیت نمی‌شود (نگاه کنید به `.gitignore`).

# ── پایگاه داده ────────────────────────────────────────────────
# پیش‌فرض در غیاب این متغیر: mongodb://localhost:27017/malli-kids
MONGODB_URI=mongodb://localhost:27017/malli-kids

# ── هویت (Better Auth) ─────────────────────────────────────────
BETTER_AUTH_SECRET=یک-رشته-تصادفی-بلند-بگذارید
BETTER_AUTH_URL=http://localhost:3000
# ایمیل‌هایی که با آن‌ها حساب ادمین ساخته می‌شود (با کاما جدا کنید)
ADMIN_EMAILS=admin@example.com

# ── آدرس عمومی سایت (سئو، canonical، نقشه سایت) ────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── ایمیل تراکنشی (SMTP) ───────────────────────────────────────
# اگر SMTP_HOST خالی باشد، ایمیل‌ها فقط در کنسول سرور لاگ می‌شوند.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── پرو مجازی (/tryon) ─────────────────────────────────────────
# موتور پیش‌فرض خودکار انتخاب می‌شود، به این ترتیب:
#   1) اگر FAL_KEY باشد → موتور FASHN TryOn v1.6 روی fal (پیشنهادی؛
#      بهترین کیفیت تست‌شده ۲۰۲۶، حدود ‎$0.075‎ برای هر عکس)
#   2) وگرنه اگر FASHN_API_KEY باشد → همان مدل از API مستقیم FASHN
#   3) وگرنه → دموی رایگان Kolors در Hugging Face (بدون کلید، ولی
#      صف مشترک و ناپایدار — فقط برای تست)
# اگر می‌خواهید صراحتاً موتور را قفل کنید، یکی از این‌ها:
# TRYON_PROVIDER=fal | fashn | huggingface
TRYON_PROVIDER=
# کلید fal.ai — از https://fal.ai/dashboard/keys بگیرید و شارژ کنید.
FAL_KEY=
# کلید مستقیم FASHN — از https://app.fashn.ai (۱۰ کردیت رایگان شروع)
FASHN_API_KEY=
# توکن اختیاری Hugging Face برای صف سریع‌تر حالت رایگان
HF_TOKEN=
# فضای جایگزین Kolors (اختیاری)
HF_TRYON_SPACE=Kwai-Kolors/Kolors-Virtual-Try-On
